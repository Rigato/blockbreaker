{
  "name": "blockbreaker",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Bricklike — portrait HTML5 MVP",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "qa:runs": "node scripts/qa-runs.mjs",
    "validate:content": "tsx scripts/validate-content.ts",
    "package": "node scripts/package.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@playgama/bridge": "2.4.1",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
