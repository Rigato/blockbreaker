{
  "name": "blockbreaker",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "Bricklike — portrait HTML5 arcade roguelite",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:bridge": "node scripts/build.mjs --bridge",
    "build:clean": "node scripts/build.mjs --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "qa:runs": "node scripts/qa-runs.mjs",
    "validate:content": "tsx scripts/validate-content.ts",
    "package": "node scripts/package.mjs --target all",
    "package:bridge": "node scripts/package.mjs --target bridge",
    "package:clean": "node scripts/package.mjs --target clean",
    "preview": "vite preview --host",
    "preview:clean": "vite preview --host --outDir dist-clean"
  },
  "dependencies": {
    "@playgama/bridge": "2.4.4",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
